{
  "name": "@sqlcopilot/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "SQL Copilot desktop application",
  "author": "SQL Copilot",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:renderer": "vite --host 127.0.0.1 --port 8888 --strictPort",
    "dev:electron": "wait-on http-get://127.0.0.1:8888/@vite/client && node scripts/run-electron-main.cjs",
    "debug:main": "wait-on http-get://127.0.0.1:8888/@vite/client && node scripts/run-electron-main.cjs --inspect=9229 --debug",
    "debug": "concurrently -k \"npm run dev:renderer\" \"npm run debug:main\"",
    "build": "vite build",
    "build:minimal": "cross-env VITE_PACKAGE_VARIANT=minimal vite build --emptyOutDir",
    "build:medium": "cross-env VITE_PACKAGE_VARIANT=medium vite build --emptyOutDir",
    "build:full": "cross-env VITE_PACKAGE_VARIANT=full vite build --emptyOutDir",
    "download:qdrant": "node scripts/download-qdrant.mjs",
    "dist": "npm run dist:medium",
    "dist:minimal": "npm run build:minimal && cross-env SQLCOPILOT_PACKAGE_VARIANT=minimal electron-builder",
    "dist:medium": "npm run build:medium && cross-env SQLCOPILOT_PACKAGE_VARIANT=medium electron-builder",
    "dist:full": "npm run build:full && cross-env SQLCOPILOT_PACKAGE_VARIANT=full electron-builder",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@sqlcopilot/shared-contracts": "file:../../packages/shared-contracts",
    "ant-design-vue": "^4.2.6",
    "echarts": "^5.6.0",
    "monaco-editor": "^0.55.1",
    "sql-formatter": "^15.7.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "36.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.sqlcopilot.desktop",
    "productName": "SQL Copilot",
    "artifactName": "SQL-Copilot-${env.SQLCOPILOT_PACKAGE_VARIANT}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "../../release/${env.SQLCOPILOT_PACKAGE_VARIANT}/desktop"
    },
    "icon": "icon.png",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/qdrant",
        "to": "qdrant",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
